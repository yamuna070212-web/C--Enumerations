#include <stdio.h>

enum Operation
{
    ADD = 1,
    SUBTRACT,
    MULTIPLY,
    DIVIDE
};

int main()
{
    int choice;

    printf("1. Add\n");
    printf("2. Subtract\n");
    printf("3. Multiply\n");
    printf("4. Divide\n");

    printf("Enter choice: ");
    scanf("%d", &choice);

    enum Operation op = choice;

    switch(op)
    {
        case ADD:
            printf("Addition selected");
            break;

        case SUBTRACT:
            printf("Subtraction selected");
            break;

        case MULTIPLY:
            printf("Multiplication selected");
            break;

        case DIVIDE:
            printf("Division selected");
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
