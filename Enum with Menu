#include <stdio.h>

enum Menu
{
    ADD = 1,
    SUBTRACT,
    MULTIPLY,
    EXIT
};

int main()
{
    int choice;

    printf("1. Add\n");
    printf("2. Subtract\n");
    printf("3. Multiply\n");
    printf("4. Exit\n");

    printf("Enter choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case ADD:
            printf("Addition selected");
            break;

        case SUBTRACT:
            printf("Subtraction selected");
            break;

        case MULTIPLY:
            printf("Multiplication selected");
            break;

        case EXIT:
            printf("Program exited");
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
