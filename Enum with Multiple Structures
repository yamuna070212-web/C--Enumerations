#include <stdio.h>

enum Status
{
    ACTIVE,
    INACTIVE
};

typedef struct
{
    int id;
    char name[20];
    enum Status status;
} Employee;

int main()
{
    Employee e[3] =
    {
        {101, "Ravi", ACTIVE},
        {102, "Priya", INACTIVE},
        {103, "Amit", ACTIVE}
    };

    for(int i = 0; i < 3; i++)
    {
        printf("%d %s %d\n",
               e[i].id,
               e[i].name,
               e[i].status);
    }

    return 0;
}
Output
101 Ravi 0
102 Priya 1
103 Amit 0
