#include <stdio.h>

enum Operation
{
    ADD = 1,
    SUBTRACT,
    MULTIPLY,
    DIVIDE
};

int main()
{
    int a = 20, b = 10;
    enum Operation op = MULTIPLY;

    switch(op)
    {
        case ADD:
            printf("Result = %d\n", a + b);
            break;

        case SUBTRACT:
            printf("Result = %d\n", a - b);
            break;

        case MULTIPLY:
            printf("Result = %d\n", a * b);
            break;

        case DIVIDE:
            printf("Result = %d\n", a / b);
            break;
    }

    return 0;
}
Output
Result = 200
